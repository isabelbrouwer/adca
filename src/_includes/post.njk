---
layout: base.njk
---

<div class="section bg-white post-page">
  <div class="wrap">
    <div class="inner">
      <div class="post-header">
        <a href="{{ '/blog/' | url }}" class="post-back">← Terug naar blog</a>
        <div class="post-meta-line">
          <span class="blog-date">{{ date | postDate }}</span>
          {% if category %}<span class="blog-tag">{{ category }}</span>{% endif %}
        </div>
        <h1 class="h1 post-title">{{ title }}</h1>
        {% if description %}<p class="post-description">{{ description }}</p>{% endif %}
      </div>
      <div class="post-body">
        {{ content | safe }}
      </div>
    </div>
  </div>
</div>

{% set morePosts = collections.posts | reverse | otherPosts(page.url, 3) %}
{% if morePosts.length %}
<div class="section bg-light">
  <div class="wrap">
    <div class="inner">
      <div class="blog-top" style="margin-bottom:2rem;">
        <div>
          <p class="label">Meer lezen</p>
          <h2 class="h2">Andere <span class="accent">artikelen</span></h2>
        </div>
        <a href="{{ '/blog/' | url }}" class="blog-link">Alle artikelen</a>
      </div>
      <div class="blog-grid">
        {% for post in morePosts %}
        <a href="{{ post.url }}" class="blog-card">
          <div class="blog-card-stripe"></div>
          <div class="blog-card-body">
            <div class="blog-date">{{ post.date | postDate }}</div>
            <h3>{{ post.data.title }}</h3>
            <p>{{ post.data.description }}</p>
            {% if post.data.category %}<span class="blog-tag">{{ post.data.category }}</span>{% endif %}
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% endif %}

<!-- CTA -->
<div class="section bg-cta" id="contact">
  <div class="wrap">
    <div class="inner">
      <div class="cta-inner">
        <p class="label label-center">Aan de slag</p>
        <h2 class="h2">Klaar om de regie<br><span class="accent">terug te nemen?</span></h2>
        <p style="color:var(--ink-mid);font-weight:300;margin-top:1rem;margin-bottom:2rem;line-height:1.7;">Plan een vrijblijvend gesprek van 30 minuten. We kijken samen of Adca bij jouw organisatie past.</p>
        <div class="cta-buttons">
          <a href="https://outlook.office.com/bookwithme/user/cb310ae456174eb594417edf0740f39d@adcacontractbeheer.nl/meetingtype/s660XaIlk0CVm-a0iHuZmA2?anonymous&ep=mCardFromTile" class="btn btn-red" target="_blank" rel="noopener">Plan een kennismaking</a>
          <a href="https://outlook.office.com/bookwithme/user/cb310ae456174eb594417edf0740f39d@adcacontractbeheer.nl/meetingtype/sDh4RmD2qkyaTHCTCf2chg2?anonymous&ep=mCardFromTile" class="btn btn-ghost" target="_blank" rel="noopener">Plan een demo (1 uur)</a>
        </div>
      </div>
    </div>
  </div>
</div>
